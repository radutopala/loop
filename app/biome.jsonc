{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["src/**", "electron/**", "!dist", "!dist-electron"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 200
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      // Rules below fail on the pre-Biome codebase and only offer unsafe
      // fixes. Disabled at adoption to keep the reformat commit
      // behavior-neutral; re-enable incrementally as the violations get
      // cleaned up. a11y is off wholesale — this is an internal Electron
      // app and the 600+ violations (button types, svg titles) aren't
      // worth the churn today.
      "a11y": "off",
      "style": {
        "noNonNullAssertion": "off",
        "useTemplate": "off"
      },
      "correctness": {
        "useExhaustiveDependencies": "off",
        "useHookAtTopLevel": "off"
      },
      "suspicious": {
        "noArrayIndexKey": "off",
        "noExplicitAny": "off",
        "noGlobalIsNan": "off",
        "noControlCharactersInRegex": "off",
        "noImplicitAnyLet": "off",
        "useIterableCallbackReturn": "off",
        "noAssignInExpressions": "off",
        "noShadowRestrictedNames": "off"
      },
      "complexity": {
        "useLiteralKeys": "off",
        "useOptionalChain": "off",
        "noUselessFragments": "off"
      },
      "security": {
        "noDangerouslySetInnerHtml": "off"
      }
    }
  }
}
