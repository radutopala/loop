# Loop agent bashrc — sourced by interactive bash shells spawned via
# docker exec (e.g. the terminal panel in the web UI).
#
# With the seccomp gate on, those shells already run under
# `loop syscallwrap`, so everything started from them, claude included, is
# subject to the same approval rules as the main agent process.

# Load the user's own bashrc first (bind-mounted by the host if present).
[ -r "$HOME/.bashrc" ] && . "$HOME/.bashrc"
