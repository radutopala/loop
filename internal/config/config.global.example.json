  //  //  // Built-in baseline denies: swarm/secrets/plugins, /containers/create with host-mount or --privileged,
  //  //  //                          container updates that add CapAdd/Privileged.
  //  //  //"http_rules": [ { "methods": ["POST"], "paths": ["^/my/route$"], "decision": "deny" } ],
  //  //  //"body_rules": [ /* see docs/gates.md */ ]
