  //  //  //                    git push|remote-add|config-global|clean-fdx -> approve ]
  //  //  //   file_rules:    denies for /proc/{mem,kcore}-reads, /etc/shadow, ~/.ssh/**, ~/.aws/**,
  //  //  //                  ~/.claude/settings{,.local}.json-writes, ~/.bashrc-writes,
  //  //  //                  ~/.{docker/config.json,npmrc}-writes (reads allowed for tooling),
  //  //  //                  /etc/**-writes, /usr/**-writes; allows for /work/**, /tmp/**, /proc/**-reads.
  //  //  //"path_rules":    [ { "pattern": "/custom/socket", "decision": "deny", "message": "internal socket" } ],
  //  //  //"command_rules": [ { "commands": ["curl"], "args_patterns": ["evil\\.com"], "decision": "deny" } ],
  //  //  //"file_rules":    [ { "paths": ["/project-secret/**"], "operations": ["read","write"], "decision": "deny" } ]
  //  //},
  //
  //  // Docker HTTP proxy: per-method / per-path rules for container -> docker.sock traffic.
  //  // Automatically enabled when agentgate.enabled is true. Disable only if you also disable the gate.
  //  //"docker_proxy": {
  //  //  "enabled": true,
  //  //  "default_decision": "approve",  // "allow" | "approve" | "deny"; "approve" surfaces unknown routes as prompts
