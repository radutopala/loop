  // Browser automation: Docker (headless container) and Host (local Chrome) modes.
  // When enabled, Chrome starts lazily on first use and auto-stops after 5 min idle.
  // Host mode requires chrome://inspect/#remote-debugging enabled in Chrome.
  //"browser": {
  //  "enabled": true,
  //  "chrome_image": "loop-chrome:latest",
  //  "host_cdp_port": 9222
  //},

  // RBAC permissions: owners can do everything (including allow/deny); members can trigger and manage tasks.
  // If all config and DB permissions are empty, everyone is treated as owner (bootstrap mode).
  //"permissions": {
  //  "owners":  { "users": ["U12345678"], "roles": ["1234567890123456789"] },
  //  "members": { "users": [], "roles": [] }
  //},

  // Architectural-quality engine. Scans are manual (panel "Scan now",
  // `loop quality scan`, or the `quality_scan` MCP tool) — there is no
  // background loop.
  //"quality": {
  //  // Refuse to scan when the post-exclusion file count exceeds this. 0 = engine default (25000).
  //  //"max_files": 25000,
  //  // Additional path patterns skipped during scan (applied after built-in defaults and .gitignore).
  //  //"exclude_paths": ["./generated/**", "./vendor/**"],
  //  // Per-rule overrides. Built-in rules: no_import_cycles, signal_floor, parse_fail.
  //  // Missing entries keep the default; threshold 0 keeps the default.
  //  //"rules": {
  //  //  "signal_floor":     { "enabled": true, "threshold": 6000 },
  //  //  "parse_fail":       { "enabled": true, "threshold": 0.005 },
  //  //  "no_import_cycles": { "enabled": false }
  //  //}
  //},

  // Semantic memory search configuration.
  // Must be explicitly enabled. Paths are resolved per project work dir.
  "memory": {
    // Must be explicitly true to enable semantic memory search
    "enabled": true,
    "paths": ["./memory", "!./memory/plans"], // absolute or relative; prefix with ! to exclude
    //"max_chunk_chars": 5000, // max chars per embedding chunk; increase for models with larger context
    //"reindex_interval_sec": 300, // periodic re-index interval in seconds (default: 300 = 5 min)
    "embeddings": {
      "provider": "ollama",
      "model": "nomic-embed-text"
      //"ollama_url": "http://localhost:11434"
    }
  },

  // Security gates umbrella: both enforcement layers share the same approval backend, rate
  // limits, and audit sink. Enabled by default. See docs/gates.md for the threat model.
  // Omit this block entirely to accept all defaults.
  //"gates": {
  //  //"rate_limits": { "pending": 30, "per_minute": 60, "total": 500 },
  //  //"audit":       { "retention_days": 30 },
  //
  //  // Kernel-level seccomp gate (agentgate).
  //  //"agentgate": {
  //  //  "enabled": true,                  // set false to disable the gate entirely
